[
 {
  "text": "还没切哦！用刀在燕菜上划一条线。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "9a2be9d2"
 },
 {
  "text": "不公平！有的大，有的小。每一块要一样大才行。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "1e8b9088"
 },
 {
  "text": "想怎么切就怎么切！切成一样大，看看是几分之几。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "5c9adc3e"
 },
 {
  "text": "有2位朋友来吃西瓜燕菜。切一切，每人要一样多！",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "096b9121"
 },
 {
  "text": "块数不够分给2位朋友，再切一切！",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "b8a9f25f"
 },
 {
  "text": "这些块分给2位朋友，分不完哦。再来一次。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "f00d9270"
 },
 {
  "text": "切得一样大，真公平！每人得到二分之一。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "38a0b867"
 },
 {
  "text": "切得一样大，真公平！每人得到四分之二。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "558a72aa"
 },
 {
  "text": "切得一样大，真公平！每人得到六分之三。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "50132d7d"
 },
 {
  "text": "切得一样大，真公平！每人得到八分之四。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "42aa69c9"
 },
 {
  "text": "切得一样大，真公平！每人得到十分之五。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "5e583456"
 },
 {
  "text": "切得一样大，真公平！每人得到12分之六。",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "24306d7b"
 },
 {
  "text": "有2位朋友来吃斑斓椰浆燕菜。切一切，每人要一样多！",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "6b61920c"
 },
 {
  "text": "有4位朋友来吃芒果燕菜。切一切，每人要一样多！",
  "voice": "zh-CN-XiaoxiaoNeural",
  "key": "008fb3b1"
 },
 {
  "text": "块数不够分给4位朋友，再切一切！",
